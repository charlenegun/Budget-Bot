# Get this from @BotFather with /newbot. Keep it secret, never commit it.
TELEGRAM_TOKEN=123456789:AAExampleTokenReplaceMe

# Where the SQLite file lives. Absolute path in production.
DB_PATH=/opt/foodbot/foodbot.db

# Defaults applied to a new group. Changeable in-chat with /settz and /setcurrency.
DEFAULT_TZ=Asia/Singapore
DEFAULT_CURRENCY=S$
